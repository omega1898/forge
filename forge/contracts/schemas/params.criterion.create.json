{
  "$defs": {
    "JsonValue": {}
  },
  "$id": "forge:contracts/params.criterion.create",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assessment_method": {
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "title": "Assessment Method",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Parameters",
      "type": "object"
    },
    "required_environments": {
      "items": {
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Required Environments",
      "type": "array"
    },
    "subject": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Subject",
      "type": "string"
    },
    "waiver_policy": {
      "default": "forbidden",
      "enum": [
        "forbidden",
        "allowed_with_decision"
      ],
      "title": "Waiver Policy",
      "type": "string"
    }
  },
  "required": [
    "subject",
    "assessment_method"
  ],
  "title": "CriterionCreateParams",
  "type": "object"
}
