{
  "$id": "forge:contracts/params.task.transition",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "reason": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "task_id": {
      "pattern": "^task_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Task Id",
      "type": "string"
    },
    "to_status": {
      "enum": [
        "queued",
        "running",
        "blocked",
        "waiting_for_user",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "To Status",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "to_status",
    "reason"
  ],
  "title": "TaskTransitionParams",
  "type": "object"
}
