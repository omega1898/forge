{
  "$defs": {
    "Budget": {
      "additionalProperties": false,
      "description": "Upper limits a task may consume. Milliseconds, measured monotonically.",
      "properties": {
        "max_attempts": {
          "maximum": 20,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_wall_ms": {
          "maximum": 86400000,
          "minimum": 1,
          "title": "Max Wall Ms",
          "type": "integer"
        }
      },
      "required": [
        "max_wall_ms",
        "max_attempts"
      ],
      "title": "Budget",
      "type": "object"
    },
    "RevisionRef": {
      "additionalProperties": false,
      "description": "A reference to a specific revision of a record.\n\nMeaning can change between revisions, so a test assessed against\nrequirement revision 2 must not silently satisfy revision 3.",
      "properties": {
        "id": {
          "pattern": "^[a-z]+_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "title": "RevisionRef",
      "type": "object"
    }
  },
  "$id": "forge:contracts/params.task.create",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_ref": {
      "anyOf": [
        {
          "pattern": "^grant_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authority Ref"
    },
    "budget": {
      "$ref": "#/$defs/Budget"
    },
    "criterion_refs": {
      "items": {
        "$ref": "#/$defs/RevisionRef"
      },
      "maxItems": 64,
      "title": "Criterion Refs",
      "type": "array"
    },
    "depends_on": {
      "items": {
        "pattern": "^task_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Depends On",
      "type": "array"
    },
    "input_refs": {
      "items": {
        "$ref": "#/$defs/RevisionRef"
      },
      "maxItems": 64,
      "title": "Input Refs",
      "type": "array"
    },
    "requirement_refs": {
      "items": {
        "$ref": "#/$defs/RevisionRef"
      },
      "maxItems": 64,
      "title": "Requirement Refs",
      "type": "array"
    },
    "task_type": {
      "enum": [
        "prepare",
        "execute",
        "assess",
        "decide"
      ],
      "title": "Task Type",
      "type": "string"
    },
    "title": {
      "maxLength": 300,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "workflow_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Workflow Revision",
      "type": "integer"
    }
  },
  "required": [
    "task_type",
    "title",
    "budget"
  ],
  "title": "TaskCreateParams",
  "type": "object"
}
