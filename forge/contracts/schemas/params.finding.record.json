{
  "$id": "forge:contracts/params.finding.record",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Claim",
      "type": "string"
    },
    "confirmation": {
      "default": "suspected",
      "enum": [
        "suspected",
        "confirmed"
      ],
      "title": "Confirmation",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "pattern": "^evidence_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Evidence Refs",
      "type": "array"
    },
    "fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Fingerprint",
      "type": "string"
    },
    "line": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Line"
    },
    "path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Path"
    },
    "rule_id": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Rule Id",
      "type": "string"
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "snapshot_id": {
      "anyOf": [
        {
          "pattern": "^snapshot_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Id"
    }
  },
  "required": [
    "rule_id",
    "claim",
    "severity",
    "fingerprint"
  ],
  "title": "FindingRecordParams",
  "type": "object"
}
